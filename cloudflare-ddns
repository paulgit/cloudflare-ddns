#!/usr/bin/env bash
# ============================================================
# cloudflare-ddns
# Version: 2.6
#
# Uses Cloudflare as a Dynamic DNS provider to keep DNS records
# automatically updated with the current public IP address.
#
# Design choices:
#  - Authentication: API Token (preferred) with fallback to the
#    legacy Global API Key. Tokens can be scoped to DNS:Edit on
#    a single zone, limiting blast radius if leaked.
#  - Config format: JSON, read via jq. Default location is
#    ~/.config/cloudflare-ddns/cloudflare-ddns.json (respects
#    $XDG_CONFIG_HOME). Override with --config PATH.
#  - Runtime data (cached IDs, log, lock) go in
#    ${XDG_STATE_HOME}/cloudflare-ddns (default ~/.local/state)
#    following the XDG Base Directory Specification.
#  - Current DNS IP source: Cloudflare API rather than a dig
#    query, eliminating DNS propagation lag and the dig
#    dependency.
#  - Concurrency guard: a directory lock inside the per-user
#    state directory prevents overlapping cron invocations.
#  - Colour output: auto-detected via TTY; suppressed by the
#    NO_COLOR env var (https://no-color.org/) or by the
#    --no-color / --cron-mode command-line flags.
#  - Dry-run mode: all steps run (config load, auth check,
#    IP comparison) but the DNS PATCH call is skipped.
#
# Reference URLs:
#  https://letswp.io/cloudflare-as-dynamic-dns-raspberry-pi/
#  https://gist.github.com/benkulbertis/fff10759c2391b6618dd/
#  https://no-color.org/
#
# Credits:
#  Thanks to https://github.com/teddysun and his great scripts
#  that have inspired me with ideas to create my own.
#
# Disclaimer: No warranties are given for correct function.
# Written by: Paul Git and Claude AI
#
# Variable names are uppercased if the variable is read-only
# or if it is an external variable.
# ============================================================

set -o errexit   # abort on nonzero exitstatus
set -o nounset   # abort on unbound variable
set -o pipefail  # don't hide errors within pipes

IFS=$'\n\t'

# ------------------------------------------------------------
# Global read-only variables
# ------------------------------------------------------------
SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly VERSION="2.6"
# Runtime data follows the XDG Base Directory Specification
# (XDG_STATE_HOME, defaulting to ~/.local/state).
readonly DATA_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cloudflare-ddns"
readonly ID_FILE="$DATA_DIR/cloudflare.ids"
readonly LOG_FILE="$DATA_DIR/cloudflare.log"
# The lock lives inside the per-user state directory (mode
# 700), so no other local user can pre-create or remove it.
readonly LOCK_DIR="$DATA_DIR/lock"

# ------------------------------------------------------------
# Global mutable variables
# ------------------------------------------------------------
# Default config path; overridden by --config in main().
config_file="${XDG_CONFIG_HOME:-$HOME/.config}"
config_file+="/cloudflare-ddns/cloudflare-ddns.json"

# Maximum log file size in bytes before rotation (1 MiB).
readonly MAX_LOG_SIZE_IN_BYTES=1048576

zone_identifier=""
record_identifier=""
ip_check_urls=()

# Set to 1 by acquire_lock once this process owns LOCK_DIR;
# cleanup() only removes the lock when we own it.
lock_acquired=0

# Path of the curl stderr capture file currently in use, so
# cleanup() can remove it if the script dies mid-request.
curl_stderr_file=""

# Set to 1 by --dry-run; skips the DNS record update API call.
dry_run=0

# Set to 1 by --force; updates DNS without reading the current
# DNS value first.
force_update=0

# Colour output: enabled when stdout or stderr is a terminal
# and the NO_COLOR convention (https://no-color.org/) is unset.
# Overridden to 0 by --no-color / --cron-mode in main().
use_color=0
if { [[ -t 1 ]] || [[ -t 2 ]]; } \
     && [[ -z "${NO_COLOR:-}" ]]; then
  use_color=1
fi

# Cloudflare API auth headers; populated by build_auth_args()
# after the config file is parsed.
declare -a curl_auth_args=()

# Check curl version once for retry support (requires
# 7.26.0+). Both variables are computed once at startup and
# then frozen, hence the uppercase readonly names.
CURL_SUPPORTS_RETRY=0
CURL_VERSION=""
if command -v curl &>/dev/null; then
  CURL_VERSION=$(curl --version 2>/dev/null | head -1 \
    | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  if [[ -n "$CURL_VERSION" ]] \
      && [[ "$(printf '%s\n' '7.26.0' "$CURL_VERSION" \
        | sort -V | head -1)" == '7.26.0' ]]; then
    CURL_SUPPORTS_RETRY=1
  fi
fi
readonly CURL_VERSION CURL_SUPPORTS_RETRY

# ============================================================
# _color_text
#   Applies an ANSI SGR sequence to text when colour is on.
#   Input:  $1 - SGR attribute string (e.g. "1;31")
#           $2 - message text
#   Output: formatted (or plain) text to stdout
#   Called by: _red, _yellow
# ============================================================
function _color_text() {
  local code="$1"
  local message="$2"
  if [[ "$use_color" -eq 1 ]]; then
    printf '\033[%sm%s\033[0m' "$code" "$message"
  else
    printf '%s' "$message"
  fi
}

# ============================================================
# _red
#   Outputs bold-red text (or plain text when colour is off).
#   Input:  $1 - message
#   Output: formatted text to stdout
#   Called by: _error
# ============================================================
function _red() {
  _color_text "1;31" "$1"
}

# ============================================================
# _yellow
#   Outputs bold-yellow text (or plain text when colour is off).
#   Input:  $1 - message
#   Output: formatted text to stdout
#   Called by: _warn
# ============================================================
function _yellow() {
  _color_text "1;33" "$1"
}

# ============================================================
# _log_to_file
#   Appends a UTC-timestamped entry to LOG_FILE. Write errors
#   are silently ignored so a full or missing log never aborts
#   a DNS update.
#   Input:  $1 - severity label (INFO, WARN, ERROR)
#           $2 - message
#   Output: one line appended to LOG_FILE
#   Called by: _info, _warn, _error
# ============================================================
function _log_to_file() {
  local level="$1"
  local message="$2"
  local log_size=0

  if [[ -f "$LOG_FILE" ]]; then
    log_size=$(stat -c%s "$LOG_FILE" 2>/dev/null || printf '0')
  fi

  if [[ "$log_size" -gt "$MAX_LOG_SIZE_IN_BYTES" ]]; then
    mv -f "$LOG_FILE" "${LOG_FILE}.old" 2>/dev/null || true
  fi

  printf '%s [%s] %s\n' \
    "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$level" "$message" \
    >> "$LOG_FILE" 2>/dev/null || true
}

# ============================================================
# _info
#   Prints an informational message with timestamp to stdout
#   and appends it to the log file.
#   Input:  $1 - message
#   Output: timestamped message to stdout; entry in LOG_FILE
#   Called by: update_dns_record, check_for_ip_change
# ============================================================
function _info() {
  local message="$1"
  printf '[%s] %s\n' "$(date)" "$message"
  _log_to_file "INFO" "$message"
}

# ============================================================
# _warn
#   Prints a bold-yellow warning with timestamp to stderr and
#   appends it to the log file.
#   Input:  $1 - warning message
#   Output: timestamped warning to stderr; entry in LOG_FILE
#   Called by: load_config, load_or_fetch_identifiers,
#              build_auth_args, check_for_ip_change
# ============================================================
function _warn() {
  local message="$1"
  {
    printf '[%s] ' "$(date)"
    _yellow "WARN: $message"
    printf '\n'
  } >&2
  _log_to_file "WARN" "$message"
}

# ============================================================
# _error
#   Prints a bold-red error with timestamp to stderr, appends
#   it to the log file, and exits with code 2.
#   Note: when called inside command substitution $(...), the
#   exit only terminates the subshell; the script then aborts
#   via errexit on the failed assignment. Do not wrap such
#   assignments in conditionals (if/&&/||) or the abort is
#   silently disabled.
#   Input:  $1 - error message
#   Output: timestamped error to stderr; entry in LOG_FILE;
#           exits with code 2
#   Called by: check_dependencies, validate_config,
#              build_auth_args, cloudflare_api_call,
#              check_api_response, fetch_identifiers,
#              check_for_ip_change, acquire_lock, main
# ============================================================
function _error() {
  local message="$1"
  {
    printf '[%s] ' "$(date)"
    _red "ERROR: $message"
    printf '\n'
  } >&2
  _log_to_file "ERROR" "$message"
  exit 2
}

# ============================================================
# show_usage
#   Prints usage information to stdout.
#   Input:  none
#   Output: usage text to stdout
#   Called by: main
# ============================================================
function show_usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} [OPTIONS]

Uses Cloudflare as a Dynamic DNS provider to keep DNS records
automatically updated with the current public IP address.

Options:
  -h, --help              Show this help message and exit.
  --version               Print the version number and exit.
  --config PATH           Path to the JSON configuration file.
                          Default: ~/.config/cloudflare-ddns/
                                   cloudflare-ddns.json
  --dry-run               Run the full check (load config, auth,
                          fetch public IP, read current DNS IP)
                          but do not apply any DNS changes.
                          Logs and prints what would have changed.
  --force                 Skip the DNS value check and update the
                          record immediately to the current public
                          IP. Also refreshes cached zone/record
                          identifiers from the API. Compatible with
                          --dry-run.
  --no-color, --cron-mode Disable coloured output. Colour is
                          also suppressed automatically when
                          not attached to a terminal or when
                          the NO_COLOR env var is set.
EOF
}

# ============================================================
# check_dependencies
#   Verifies that required external tools are installed.
#   Input:  none
#   Output: error to stderr and exit if a tool is missing
#   Called by: main
# ============================================================
function check_dependencies() {
  local tool
  for tool in curl jq; do
    if ! command -v "$tool" &>/dev/null; then
      _error "'${tool}' is required but not installed."
    fi
  done
}

# ============================================================
# cleanup
#   Removes the lock directory on exit, but only when this
#   process acquired it. Without the ownership check, an
#   instance that aborts because the lock is held would delete
#   the running instance's lock on its way out. Also removes
#   the curl stderr capture file if one is still around.
#   Input:  none (reads lock_acquired, curl_stderr_file)
#   Output: lock directory removed if owned by this process;
#           leftover curl stderr temp file removed
#   Called by: trap on EXIT, trap on ERR
# ============================================================
function cleanup() {
  if [[ "$lock_acquired" -eq 1 && -d "$LOCK_DIR" ]]; then
    rm -rf "$LOCK_DIR"
  fi
  if [[ -n "$curl_stderr_file" && -f "$curl_stderr_file" ]]; then
    rm -f "$curl_stderr_file"
  fi
}

trap cleanup EXIT ERR

# ============================================================
# acquire_lock
#   Creates a lock directory atomically to prevent concurrent
#   runs. Exits with an error if the lock is already held.
#   Input:  none
#   Output: lock directory and PID file created at LOCK_DIR;
#           lock_acquired global set to 1
#   Called by: main
# ============================================================
function acquire_lock() {
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local lock_pid=""
    if [[ -f "$LOCK_DIR/pid" ]]; then
      lock_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null) || lock_pid=""
    fi
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      local err_msg="Another instance is already running"
      err_msg+=" (PID: ${lock_pid})."
      _error "$err_msg"
    fi
    # Dead PID, or no/unreadable pid file (a previous run was
    # killed between mkdir and the pid write): treat as stale.
    _warn "Removing stale lock (PID: ${lock_pid:-none})."
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null \
      || _error "Failed to re-create lock after stale removal."
  fi
  # Claim ownership immediately after the successful mkdir so
  # cleanup() still removes the lock if the pid write below
  # fails (errexit) or the process dies before completing it.
  lock_acquired=1
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}

# ============================================================
# _valid_ip
#   Validates whether a string is a valid IPv4 address. The
#   raw value is matched as-is (no whitespace stripping), so a
#   value that passes is safe to embed in the API JSON body.
#   Trailing newlines from curl are already removed by the
#   caller's command substitution.
#   Input:  $1 - string to validate
#   Output: returns 0 if valid, 1 if invalid
#   Called by: check_for_ip_change, fetch_public_ip
# ============================================================
function _valid_ip() {
  local ip="$1"
  local regex='^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\.'
  regex+='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\.'
  regex+='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])\.'
  regex+='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])$'

  [[ "$ip" =~ $regex ]]
}

# ============================================================
# _url_encode
#   Percent-encodes a string for safe inclusion in a URL query
#   parameter. Leaves alphanumerics and -_.~ unchanged.
#   Input:  $1 - string to encode
#   Output: percent-encoded string to stdout
#   Called by: fetch_identifiers
# ============================================================
function _url_encode() {
  local string="${1}"
  local length=${#string}
  local encoded=""
  local position
  for (( position=0; position<length; position++ )); do
    local char="${string:$position:1}"
    case "$char" in
      [a-zA-Z0-9.~_-]) encoded+="$char" ;;
      *) encoded+=$(printf '%%%02X' "'$char") ;;
    esac
  done
  printf '%s' "$encoded"
}

# ============================================================
# init_data_dir
#   Creates the runtime data directory with strict permissions
#   if it does not already exist, then enforces mode 700.
#   Input:  none
#   Output: DATA_DIR exists with mode 700
#   Called by: main
# ============================================================
function init_data_dir() {
  if [[ ! -d "$DATA_DIR" ]]; then
    # Subshell keeps the restrictive umask from leaking into
    # the rest of the script.
    (umask 0077 && mkdir -p "$DATA_DIR")
  fi
  chmod 700 "$DATA_DIR"
}

# ============================================================
# create_config_template
#   Creates the config directory and writes a JSON template to
#   config_file (mode 600), then exits so the user can edit it.
#   Input:  none
#   Output: config directory and config_file created
#   Called by: load_config
# ============================================================
function create_config_template() {
  local config_dir
  config_dir="$(dirname "$config_file")"
  [[ -d "$config_dir" ]] || mkdir -p "$config_dir"
  chmod 700 "$config_dir"

  (
    umask 0077
    cat > "$config_file" <<'EOF'
{
  "auth_token": "YOUR_CLOUDFLARE_API_TOKEN",
  "zone_name": "example.com",
  "record_name": "ddns.example.com",
  "ip_check_urls": [
    "https://ipv4.icanhazip.com",
    "https://api.ipify.org"
  ]
}
EOF
  )
  chmod 600 "$config_file"
}

# ============================================================
# validate_config
#   Verifies required config fields are populated and that no
#   placeholder values remain after parsing the config file.
#   Input:  none (reads globals set by load_config)
#   Output: error and exit if validation fails
#   Called by: load_config
# ============================================================
function validate_config() {
  local var
  for var in zone_name record_name; do
    if [[ -z "${!var:-}" ]]; then
      _error "Required field '${var}' not set in ${config_file}."
    fi
  done

  if [[ "${#ip_check_urls[@]}" -eq 0 ]]; then
    _error \
      "Required field 'ip_check_urls' not set in ${config_file}."
  fi

  local ip_check_url
  for ip_check_url in "${ip_check_urls[@]}"; do
    if [[ -z "$ip_check_url" ]]; then
      _error "Field 'ip_check_urls' contains an empty URL."
    fi
  done

  local auth_ok=0
  if [[ -n "${auth_token:-}" ]] \
      && ! [[ "${auth_token}" =~ ^YOUR_ ]]; then
    auth_ok=1
  elif [[ -n "${auth_email:-}" && -n "${auth_key:-}" ]] \
      && ! [[ "${auth_email}" =~ ^YOUR_ ]] \
      && ! [[ "${auth_key}" =~ ^YOUR_ ]]; then
    auth_ok=1
  fi

  if [[ "$auth_ok" -eq 0 ]]; then
    local msg="No valid auth found in ${config_file}."
    msg+=" Set 'auth_token' or 'auth_email'+'auth_key'."
    _error "$msg"
  fi
}

# ============================================================
# build_auth_args
#   Populates curl_auth_args for Cloudflare API requests.
#   API Token auth is preferred; the legacy Global API Key is
#   used as a fallback with a deprecation warning.
#   Input:  none (reads auth_token or auth_email + auth_key)
#   Output: curl_auth_args array populated
#   Called by: load_config
# ============================================================
function build_auth_args() {
  local ct="Content-Type: application/json"
  if [[ -n "${auth_token:-}" ]]; then
    curl_auth_args=(
      "-H" "Authorization: Bearer ${auth_token}"
      "-H" "$ct"
    )
  else
    _warn "Using legacy API Key auth. Switch to an API Token."
    curl_auth_args=(
      "-H" "X-Auth-Email: ${auth_email}"
      "-H" "X-Auth-Key: ${auth_key}"
      "-H" "$ct"
    )
  fi
}

# ============================================================
# load_config
#   Parses the JSON config file (creating a template on first
#   run), validates its contents, and builds the API auth args.
#   Supports both legacy 'ip_check_url' and new
#   'ip_check_urls' formats.
#   Input:  none (reads config_file global)
#   Output: auth_token/auth_email/auth_key, zone_name,
#           record_name,
#           ip_check_urls globals set; curl_auth_args built
#   Called by: main
# ============================================================
function load_config() {
  if [[ ! -f "$config_file" ]]; then
    create_config_template
    _warn "No config found. Template created at ${config_file}."
    _warn "Fill in your values, then re-run ${SCRIPT_NAME}."
    exit 1
  fi

  # Insecure means any group/other access (last two mode
  # digits non-zero); stricter modes such as 400 are left
  # untouched.
  local current_mode
  current_mode=$(stat -c '%a' "$config_file" 2>/dev/null || true)
  if [[ -z "$current_mode" \
      || "${current_mode: -2}" != "00" ]]; then
    local mode_msg="Config file permissions"
    mode_msg+=" '${current_mode:-unknown}' allow group/other"
    mode_msg+=" access. Fixing to 600."
    _warn "$mode_msg"
    chmod 600 "$config_file"
  fi

  if ! jq empty "$config_file" 2>/dev/null; then
    _error "Config file contains invalid JSON: ${config_file}"
  fi

  auth_token=$(jq -r '.auth_token  // empty' "$config_file")
  auth_email=$(jq -r '.auth_email  // empty' "$config_file")
  auth_key=$(jq -r   '.auth_key    // empty' "$config_file")
  zone_name=$(jq -r  '.zone_name   // empty' "$config_file")
  record_name=$(jq -r '.record_name // empty' "$config_file")

  mapfile -t ip_check_urls < <(
    jq -r '
      if (.ip_check_urls | type) == "array" then
        .ip_check_urls[]? // empty
      else
        .ip_check_url // empty
      end
    ' "$config_file"
  )

  if jq -e '
      (.ip_check_urls | type) != "array"
      and (.ip_check_url // empty) != ""
    ' "$config_file" >/dev/null 2>&1; then
    _warn "Legacy config key 'ip_check_url' detected."
    _warn "Please migrate to 'ip_check_urls' (array) per README."
  fi

  validate_config
  build_auth_args
}

# ============================================================
# cloudflare_api_call
#   Sends a request to the Cloudflare API and prints the JSON
#   response body. Exits on network-level failure.
#   Input:  $1 - HTTP method (GET, PATCH, …)
#           $2 - API endpoint path (/client/v4/…)
#           $3 - optional JSON request body
#   Output: API response JSON to stdout
#   Called by: fetch_identifiers, get_current_dns_ip,
#              update_dns_record
# ============================================================
function cloudflare_api_call() {
  local method="$1"
  local endpoint="$2"
  local data="${3:-}"
  local response

  # --show-error re-enables curl's error messages (suppressed
  # by --silent) so the stderr capture below has content.
  local -a curl_args=(
    "--silent"
    "--show-error"
    "--connect-timeout" "10"
    "--max-time" "30"
    "--request" "$method"
    "https://api.cloudflare.com${endpoint}"
    "${curl_auth_args[@]}"
  )

  if [[ "$CURL_SUPPORTS_RETRY" -eq 1 ]]; then
    curl_args+=("--retry" "3")
    curl_args+=("--retry-delay" "3")
  fi

  [[ -n "$data" ]] && curl_args+=("--data" "$data")

  curl_stderr_file=$(mktemp)
  response=$(curl "${curl_args[@]}" 2>"$curl_stderr_file") || {
    local detail err_msg
    detail=$(head -1 "$curl_stderr_file" 2>/dev/null)
    rm -f "$curl_stderr_file"
    curl_stderr_file=""
    err_msg="Network error calling Cloudflare API"
    err_msg+=" (${method} ${endpoint}): ${detail:-unknown}"
    _error "$err_msg"
  }
  rm -f "$curl_stderr_file"
  curl_stderr_file=""
  printf '%s' "$response"
}

# ============================================================
# check_api_response
#   Validates a Cloudflare API JSON response. Extracts and
#   reports API error messages when success is not true.
#   Input:  $1 - human-readable context label
#           $2 - raw JSON response string
#   Output: exits with error on failure
#   Called by: fetch_identifiers, get_current_dns_ip,
#              update_dns_record
# ============================================================
function check_api_response() {
  local context="$1"
  local response="$2"

  if [[ -z "$response" ]]; then
    _error "${context}: empty response from Cloudflare API."
  fi

  local success
  success=$(printf '%s' "$response" | jq -r '.success // false')

  if [[ "$success" != "true" ]]; then
    local api_errors
    api_errors=$(printf '%s' "$response" \
      | jq -r \
        '[.errors[] | "\(.code): \(.message)"] | join("; ")' \
      2>/dev/null) || api_errors="(could not parse errors)"
    _error "${context} failed: ${api_errors}"
  fi
}

# ============================================================
# fetch_identifiers
#   Retrieves zone and record identifiers from the Cloudflare
#   API and caches them in ID_FILE (mode 600).
#   Input:  none (reads zone_name, record_name globals)
#   Output: zone_identifier and record_identifier set;
#           ID_FILE written with mode 600
#   Called by: load_or_fetch_identifiers
# ============================================================
function fetch_identifiers() {
  local response zone_id record_id endpoint

  response=$(cloudflare_api_call "GET" \
    "/client/v4/zones?name=$(_url_encode "${zone_name}")")
  check_api_response "Zone lookup" "$response"
  zone_id=$(printf '%s' "$response" \
    | jq -r '.result[0].id // empty')
  if [[ ${#zone_id} -ne 32 ]]; then
    _error "Zone '${zone_name}' not found in your account."
  fi

  # Filter by type=A so a record that also has AAAA/TXT entries
  # under the same name cannot return the wrong record ID.
  endpoint="/client/v4/zones/${zone_id}/dns_records"
  endpoint+="?type=A&name=$(_url_encode "${record_name}")"
  response=$(cloudflare_api_call "GET" "$endpoint")
  check_api_response "DNS record lookup" "$response"
  record_id=$(printf '%s' "$response" \
    | jq -r '.result[0].id // empty')
  if [[ ${#record_id} -ne 32 ]]; then
    _error "Record '${record_name}' not found in '${zone_name}'."
  fi

  zone_identifier="$zone_id"
  record_identifier="$record_id"
  {
    printf 'zone_identifier=%s\nrecord_identifier=%s\n' \
      "$zone_id" "$record_id"
  } > "$ID_FILE"
  chmod 600 "$ID_FILE"
}

# ============================================================
# load_or_fetch_identifiers
#   Loads cached zone/record IDs from ID_FILE, or fetches them
#   from the Cloudflare API when the cache is absent or
#   incomplete.
#   Input:  none
#   Output: zone_identifier and record_identifier set
#   Called by: main
# ============================================================
function load_or_fetch_identifiers() {
  if [[ -f "$ID_FILE" ]]; then
    local key value valid=true
    while IFS='=' read -r key value; do
      case "$key" in
        zone_identifier)
          if [[ "$value" =~ ^[a-f0-9]{32}$ ]]; then
            zone_identifier="$value"
          else
            valid=false
          fi
          ;;
        record_identifier)
          if [[ "$value" =~ ^[a-f0-9]{32}$ ]]; then
            record_identifier="$value"
          else
            valid=false
          fi
          ;;
      esac
    done < "$ID_FILE"
    if [[ "$valid" != "true" ]]; then
      _warn "ID cache corrupted; fetching from API."
      zone_identifier=""
      record_identifier=""
    fi
  fi

  if [[ ${#zone_identifier} -eq 32 \
      && ${#record_identifier} -eq 32 ]]; then
    return 0
  fi

  _warn "ID cache missing or incomplete; fetching from API."
  fetch_identifiers
}

# ============================================================
# get_current_dns_ip
#   Retrieves the content (IP address) of the DNS A record
#   currently stored in Cloudflare for record_name.
#   Input:  none
#   Output: current IP string to stdout
#   Called by: check_for_ip_change
# ============================================================
function get_current_dns_ip() {
  local response current_ip endpoint
  endpoint="/client/v4/zones/${zone_identifier}"
  endpoint+="/dns_records/${record_identifier}"
  response=$(cloudflare_api_call "GET" "$endpoint")
  check_api_response "Current record fetch" "$response"
  current_ip=$(printf '%s' "$response" \
    | jq -r '.result.content // empty')
  printf '%s' "$current_ip"
}

# ============================================================
# patch_dns_record_content
#   Sends the PATCH request that sets the A record's content
#   to the given IP. PATCH preserves the other record fields
#   (proxied, TTL). Shared by the normal and forced paths.
#   Input:  $1 - new IP address
#   Output: DNS record updated via the Cloudflare API
#   Called by: update_dns_record, force_update_ip
# ============================================================
function patch_dns_record_content() {
  local new_ip="$1"
  local response endpoint
  endpoint="/client/v4/zones/${zone_identifier}"
  endpoint+="/dns_records/${record_identifier}"
  response=$(cloudflare_api_call "PATCH" "$endpoint" \
    "{\"content\":\"${new_ip}\"}")
  check_api_response "DNS record update" "$response"
}

# ============================================================
# update_dns_record
#   Updates the Cloudflare A record for record_name. In
#   dry-run mode the PATCH is skipped and the intended change
#   is logged instead.
#   Input:  $1 - new IP address
#           $2 - previous IP address (for the log message)
#   Output: DNS record updated (or dry-run message) and logged
#   Called by: check_for_ip_change
# ============================================================
function update_dns_record() {
  local new_ip="$1"
  local old_ip="$2"

  if [[ "$dry_run" -eq 1 ]]; then
    _info \
      "[DRY-RUN] Would update ${record_name}: ${old_ip} -> ${new_ip}"
    return 0
  fi

  patch_dns_record_content "$new_ip"
  _info "${record_name}: ${old_ip} -> ${new_ip}"
}

# ============================================================
# fetch_public_ip
#   Fetches the current public IPv4 address using the ordered
#   URLs from ip_check_urls. If one URL fails or returns an
#   invalid value, the next URL is tried.
#   Input:  none
#   Output: validated public IP address to stdout
#   Called by: check_for_ip_change, force_update_ip
# ============================================================
function fetch_public_ip() {
  local ip_check_url new_ip
  local -a curl_ip_args

  for ip_check_url in "${ip_check_urls[@]}"; do
    # --show-error re-enables curl's error messages (suppressed
    # by --silent) so the stderr capture below has content.
    curl_ip_args=(
      "--silent"
      "--show-error"
      "--connect-timeout" "5"
      "--max-time" "10"
      "$ip_check_url"
    )
    if [[ "$CURL_SUPPORTS_RETRY" -eq 1 ]]; then
      curl_ip_args+=("--retry" "3")
      curl_ip_args+=("--retry-delay" "3")
    fi

    curl_stderr_file=$(mktemp)
    if ! new_ip=$(curl "${curl_ip_args[@]}" \
        2>"$curl_stderr_file"); then
      local detail warn_msg
      detail=$(head -1 "$curl_stderr_file" 2>/dev/null)
      rm -f "$curl_stderr_file"
      curl_stderr_file=""
      warn_msg="Failed to get public IP from ${ip_check_url}:"
      warn_msg+=" ${detail:-unknown}; trying next URL."
      _warn "$warn_msg"
      continue
    fi
    rm -f "$curl_stderr_file"
    curl_stderr_file=""

    if ! _valid_ip "$new_ip"; then
      local invalid_msg="Public IP check from ${ip_check_url}"
      invalid_msg+=" returned invalid value: '${new_ip}'."
      _warn "$invalid_msg"
      continue
    fi

    printf '%s' "$new_ip"
    return 0
  done

  local fail_msg="All configured IP check URLs failed."
  fail_msg+=" Check 'ip_check_urls' in ${config_file}."
  _error "$fail_msg"
}

# ============================================================
# check_for_ip_change
#   Fetches the current public IP and compares it with the
#   value stored in Cloudflare. Updates the DNS record if
#   they differ. In dry-run mode, logs the outcome without
#   making any changes.
#   Input:  none
#   Output: DNS record updated (or dry-run message) if changed;
#           no-change message when IPs already match (dry-run)
#   Called by: main
# ============================================================
function check_for_ip_change() {
  local new_ip old_ip

  new_ip=$(fetch_public_ip)

  old_ip=$(get_current_dns_ip)
  if [[ -z "$old_ip" ]] || ! _valid_ip "$old_ip"; then
    _warn "Current DNS IP unreadable; forcing update."
    update_dns_record "$new_ip" "unknown"
    return 0
  fi

  if [[ "$new_ip" != "$old_ip" ]]; then
    update_dns_record "$new_ip" "$old_ip"
  elif [[ "$dry_run" -eq 1 ]]; then
    _info \
      "[DRY-RUN] No change needed. ${record_name} is already ${new_ip}"
  fi
}

# ============================================================
# force_update_ip
#   Fetches the current public IP and unconditionally updates
#   the Cloudflare DNS record, skipping the DNS value read.
#   In dry-run mode the PATCH is skipped and the intended
#   action is logged instead.
#   Input:  none
#   Output: DNS record updated (or dry-run message) and logged.
#           Log clearly indicates the update was forced.
#   Called by: main
# ============================================================
function force_update_ip() {
  local new_ip
  new_ip=$(fetch_public_ip)

  if [[ "$dry_run" -eq 1 ]]; then
    local msg="[DRY-RUN] [FORCED] Would update ${record_name}"
    msg+=" to ${new_ip} (DNS check skipped)"
    _info "$msg"
    return 0
  fi

  patch_dns_record_content "$new_ip"
  _info \
    "[FORCED] ${record_name}: updated to ${new_ip} (DNS check skipped)"
}

# ============================================================
# main
#   Entry point. Parses flags, then runs the DDNS update cycle.
#   Input:  $@ - command line arguments
#   Output: varies based on operation
# ============================================================
function main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        show_usage
        exit 0
        ;;
      --version)
        printf '%s %s\n' "$SCRIPT_NAME" "$VERSION"
        exit 0
        ;;
      --dry-run)
        dry_run=1
        ;;
      --force)
        force_update=1
        ;;
      --no-color|--cron-mode)
        use_color=0
        ;;
      --config)
        if [[ $# -lt 2 || -z "${2:-}" ]]; then
          _error "--config requires a file path argument."
        fi
        config_file="$2"
        shift
        ;;
      --config=*)
        config_file="${1#--config=}"
        if [[ -z "$config_file" ]]; then
          _error "--config= requires a file path argument."
        fi
        ;;
      *)
        printf 'Unknown option: %s\n' "$1" >&2
        show_usage >&2
        exit 1
        ;;
    esac
    shift
  done

  check_dependencies
  init_data_dir
  load_config
  acquire_lock

  # When --force is used, discard the cached identifiers so they
  # are re-fetched from the API (handles zone/record renames).
  if [[ "$force_update" -eq 1 ]] && [[ -f "$ID_FILE" ]]; then
    rm -f "$ID_FILE"
  fi

  load_or_fetch_identifiers
  if [[ "$force_update" -eq 1 ]]; then
    force_update_ip
  else
    check_for_ip_change
  fi
}

main "$@"
